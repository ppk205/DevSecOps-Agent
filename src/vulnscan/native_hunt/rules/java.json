{
  "language": "java",
  "rules": [
    {
      "id": "java-sql-concatenation",
      "languages": [
        "java"
      ],
      "severity": "ERROR",
      "message": "SQL constructed through concatenation; use a parameterized query.",
      "cwe": "89",
      "attack": "sql_injection",
      "patterns": [
        "\\.executeQuery\\s*\\([^)]*\\+",
        "\\.executeUpdate\\s*\\([^)]*\\+",
        "\\.execute\\s*\\([^)]*\\+"
      ],
      "source": "src/vulnscan/scanners/rules/java.yml#java-sql-concatenation"
    },
    {
      "id": "java-xss-response-writer",
      "languages": [
        "java"
      ],
      "severity": "ERROR",
      "message": "Request data reaches an HTTP response without escaping; use a safe encoder.",
      "cwe": "79",
      "attack": "xss",
      "patterns": [
        "getWriter\\s*\\(\\s*\\)\\s*\\.\\s*(write|print|println)\\s*\\(",
